{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "express"
    },
    "portfolio": {
      "root": "apps/portfolio",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "dashboard": {
      "root": "apps/dashboard",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "portfolio"
      }
    }
  ]
}
